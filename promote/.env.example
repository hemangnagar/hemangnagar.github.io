# Copy to .env (same folder) and fill in ONE of the two modes. .env is gitignored.

# MODE A - OAuth 1.0a (preferred; token never expires). Generate the Access
# Token AFTER app permissions are set to Read and write.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# MODE B - OAuth 2.0 (console shows a 2-hour access token + 6-month refresh token).
# Paste the REFRESH token; the script mints access tokens itself and rewrites this
# line with the rotated refresh token after each run.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=
